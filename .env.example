# Copy to .env outside of version control. Set real values only on the host.
RPC_URL=https://rpc.example.invalid
MULTISIG_ADDRESS=0x0000000000000000000000000000000000000000
LNBITS_DOMAIN=lnbits.example.invalid
LNBITS_API_KEY=replace-with-new-invoice-only-key
BANNER_ENDPOINT=http://127.0.0.1:3456/startshow
TLS_KEY_PATH=/run/secrets/yvrsidewalk-tls-key
TLS_CERT_PATH=/run/secrets/yvrsidewalk-tls-cert
# Explicit allowed browser origins. Do not use a wildcard in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Amount in satoshis, never millisatoshis.
MAX_INVOICE_SATS=100000
INVOICE_REQUESTS_PER_MINUTE=8
INVOICE_GLOBAL_REQUESTS_PER_MINUTE=120

# Optional read-only Polygon history API. Never expose this key to browsers.
# V2 uses https://api.etherscan.io/v2/api?chainid=137
ETHERSCAN_API_KEY=replace-with-new-server-side-etherscan-v2-key
